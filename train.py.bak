import argparse
import json
import subprocess
import sys

from pathlib import Path
from datetime import datetime, timezone
from uuid import uuid4

import joblib
import sklearn
from sklearn.datasets import load_iris
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score
from sklearn.model_selection import train_test_split
from sklearn.pipeline import make_pipeline
from sklearn.preprocessing import StandardScaler

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--c",
        type=float,
        default=1.0,
        help="Logistic regression C; smaller values mean stronger regularization.",
    )
    args = parser.parse_args()

    if args.c <= 0:
        parser.error("--c must be greater than zero")

    # 1. Load a built-in dataset
    # Input: flower measurements. Labels: flower species
    dataset = load_iris()

    # 2. Hold back test data before training.
    X_train, X_test, y_train, y_test = train_test_split(
        dataset.data,
        dataset.target,
        test_size=0.2,
        random_state=42,
        stratify=dataset.target,
    )

    # 3. Bundle preprocessing and the model together
    model = make_pipeline(
        StandardScaler(),
        LogisticRegression(
            C=args.c,
            max_iter=1000, 
            random_state=42,
        ),
    )

    # Learn only using the training data
    model.fit(X_train, y_train)

    # 4. Evaluate on data the model did not train on
    prediction = model.predict(X_test)
    accuracy = accuracy_score(y_test, prediction)

    # 5. Save the model and evaluate information
    run_id = (
        datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        + "-"
        + uuid4().hex[:8]
    )

    output_dir = Path("artifacts") / run_id
    output_dir.mkdir(parents=True, exist_ok=False)

    dependencies = subprocess.run(
        [sys.executable, "-m", "pip", "freeze"],
        check=True,
        capture_output=True,
        text=True,
    )

    (output_dir / "requirements.txt").write_text(
        dependencies.stdout,
        encoding="utf-8",
    )

    metrics = {
        "C": args.c,
        "run_id": run_id,
        "test_size": 0.2,
        "model_type": "StandardScaler + LogicsticRegression",
        "max_iter": 1000,
        "dataset": "iris",
        "accuracy": float(accuracy),
        "training_samples": len(y_train),
        "test_samples": len(y_test),
        "random_seed": 42,
        "scikit_learn_version": sklearn.__version__,
        "feature_names": list(dataset.feature_names),
        "class_names": list(dataset.target_names),
    }

    joblib.dump(model, output_dir / "model.joblib")
    (output_dir / "metrics.json").write_text(
        json.dumps(metrics, indent=2) + "\n",
        encoding="utf-8",
    )

    # 6. Verfiy that the saved model can be reloaded
    reloaded_model = joblib.load(output_dir / "model.joblib")
    assert (reloaded_model.predict(X_test) == prediction).all()

    print(f"C: {args.c}")
    print(f"Training samples: {len(y_train)}")
    print(f"Test samples: {len(y_test)}")
    print(f"Test accuracy: {accuracy: .3f}")
    print(f"Run ID: {run_id}")
    print(f"Saved: {output_dir / 'model.joblib'}")
    print(f"Saved: {output_dir / 'metrics.json'}")
    print("Reload check passed: predictions match.")

if __name__ == "__main__":
    main()